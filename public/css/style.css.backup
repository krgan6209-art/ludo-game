@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap');

* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #0f172a;
  --panel: rgba(30,41,59,0.85);
  --primary: #3b82f6;
  --accent: #f59e0b;
  --danger: #ef4444;
  --success: #22c55e;
  --text: #f8fafc;
  --muted: #94a3b8;
  --glass: rgba(255,255,255,0.06);
}

body {
  margin: 0; padding: 0;
  font-family: 'Vazirmatn', Tahoma, system-ui, sans-serif;
  background: radial-gradient(circle at 20% 20%, #1e293b, #0f172a 60%);
  color: var(--text);
  direction: rtl;
  min-height: 100vh;
  overflow-x: hidden;
}

.page {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 100vh; padding: 16px;
}

.hidden { display: none !important; }

.glass {
  background: var(--glass);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.35);
}

.card {
  width: 100%; max-width: 420px; padding: 28px;
  text-align: center; animation: fadeIn 0.5s ease;
}

.card h1, .card h2 { margin: 8px 0 18px; }
.card input {
  width: 100%; padding: 14px; margin: 8px 0;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 14px; background: rgba(0,0,0,0.25);
  color: var(--text); font-size: 16px; outline: none;
}
.card input:focus { border-color: var(--primary); }
.card button {
  width: 100%; padding: 14px; margin-top: 10px;
  border: none; border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), #60a5fa);
  color: white; font-size: 18px; font-weight: 700; cursor: pointer;
  transition: transform 0.1s, box-shadow 0.2s;
}
.card button:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(59,130,246,0.35); }
.card button.secondary { background: rgba(255,255,255,0.1); margin-top: 8px; }
.card a { color: #93c5fd; text-decoration: none; }
.error { color: #fca5a5; min-height: 22px; margin: 6px 0 0; font-size: 14px; }

/* Lobby */
.lobby-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 10;
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
}
.profile-snippet { display: flex; align-items: center; gap: 10px; }
.profile-snippet img { width: 40px; height: 40px; border-radius: 50%; background: #334155; }
.lobby-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;
  width: 100%; max-width: 520px; margin-top: 80px;
}
.lobby-card {
  padding: 24px; text-align: center; font-size: 18px; font-weight: 700; cursor: pointer;
  transition: transform 0.15s, box-shadow 0.2s;
}
.lobby-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.35); }

/* Room */
.room-code { font-size: 32px; letter-spacing: 6px; font-weight: 800; color: var(--accent); margin: 10px 0; }
#waiting-opponent { margin: 12px 0; color: var(--muted); }

/* Game */
#game-page { padding: 0; justify-content: flex-start; }
.game-header {
  position: sticky; top: 0; z-index: 10; width: 100%;
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 14px;
}
.player-badge { padding: 8px 12px; border-radius: 999px; background: rgba(0,0,0,0.35); font-weight: 700; font-size: 14px; }
.game-status { font-weight: 800; color: var(--accent); font-size: 15px; }

.game-body {
  display: flex; flex: 1; width: 100%; max-width: 1100px; gap: 14px; padding: 14px; align-items: flex-start; margin: 0 auto;
}

.board-container { flex: 1; display: flex; flex-direction: column; align-items: center; }
.board {
  display: grid;
  grid-template-columns: repeat(15, 1fr);
  grid-template-rows: repeat(15, 1fr);
  width: min(92vw, 520px); height: min(92vw, 520px);
  gap: 2px;
}
.cell {
  background: rgba(255,255,255,0.06);
  border-radius: 6px; position: relative; aspect-ratio: 1;
}
.cell.safe { background: rgba(245,158,11,0.25); box-shadow: inset 0 0 10px rgba(245,158,11,0.15); }
.cell.home-red { background: rgba(239,68,68,0.35); }
.cell.home-blue { background: rgba(59,130,246,0.35); }
.cell.start-red { background: rgba(239,68,68,0.55); }
.cell.start-blue { background: rgba(59,130,246,0.55); }
.cell.center { background: radial-gradient(circle, rgba(16,185,129,0.6), rgba(5,150,105,0.9)); }

.piece {
  width: 70%; height: 70%; border-radius: 50%;
  position: absolute; top: 15%; left: 15%;
  box-shadow: 0 2px 8px rgba(0,0,0,0.4); cursor: pointer;
  transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  z-index: 2;
}
.piece.red { background: radial-gradient(circle at 30% 30%, #fca5a5, #dc2626); border: 2px solid #7f1d1d; }
.piece.blue { background: radial-gradient(circle at 30% 30%, #bfdbfe, #2563eb); border: 2px solid #1e3a8a; }
.piece:hover { transform: scale(1.15); }

.dice-area { margin-top: 14px; text-align: center; }
.dice-btn {
  padding: 14px 22px; border-radius: 16px; border: none;
  background: linear-gradient(135deg, var(--accent), #fbbf24); color: #422006;
  font-size: 20px; font-weight: 800; cursor: pointer;
}
.dice-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.dice-result { font-size: 48px; margin-top: 10px; min-height: 64px; }

/* Side panel */
.side-panel {
  width: 320px; max-height: calc(100vh - 80px); display: flex; flex-direction: column;
  position: sticky; top: 80px;
}
.panel-header { display: flex; justify-content: space-between; align-items: center; padding: 10px; font-weight: 800; }
.chat-messages { flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px; min-height: 200px; }
.chat-msg { background: rgba(0,0,0,0.25); padding: 10px; border-radius: 12px; }
.chat-msg .meta { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
.chat-msg.system { background: rgba(16,185,129,0.18); color: #a7f3d0; }

.reactions { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px; justify-content: center; }
.reactions button { background: rgba(0,0,0,0.35); border: none; border-radius: 10px; padding: 6px 8px; font-size: 18px; cursor: pointer; transition: transform 0.1s; }
.reactions button:hover { transform: scale(1.2); }
.chat-input-row { display: flex; gap: 8px; padding: 8px; }
.chat-input-row input { flex: 1; padding: 10px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.3); color: white; outline: none; }
.chat-input-row button { padding: 10px 14px; border-radius: 12px; border: none; background: var(--primary); color: white; cursor: pointer; }

.voice-controls { display: flex; gap: 8px; padding: 8px; justify-content: center; }
.voice-controls button { padding: 8px 10px; border-radius: 10px; border: none; background: rgba(0,0,0,0.4); color: white; cursor: pointer; font-size: 13px; }

#floating-reaction {
  position: fixed; top: 20%; left: 50%; transform: translateX(-50%);
  font-size: 64px; pointer-events: none; opacity: 0; z-index: 100;
}
#floating-reaction.show { opacity: 1; animation: floatUp 1.2s ease forwards; }

.connection-status {
  position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
  background: rgba(15,23,42,0.95); padding: 10px 18px; border-radius: 999px;
  border: 1px solid rgba(245,158,11,0.4); color: var(--accent); font-weight: 700; z-index: 50;
}

.endgame h1 { color: var(--accent); font-size: 36px; }
.endgame button { margin-top: 10px; }

.big-avatar { width: 100px; height: 100px; border-radius: 50%; margin: 10px auto; display: block; background: #334155; }

/* Responsive */
@media (max-width: 800px) {
  .game-body { flex-direction: column; align-items: center; }
  .side-panel { width: 100%; max-height: 320px; position: static; }
  .board { width: 96vw; height: 96vw; }
  .lobby-grid { grid-template-columns: 1fr; }
}

@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes floatUp { 0% { transform: translateX(-50%) translateY(0) scale(0.8); opacity: 0; } 20% { opacity: 1; transform: translateX(-50%) translateY(-10px) scale(1.1); } 100% { transform: translateX(-50%) translateY(-120px) scale(1); opacity: 0; } }
